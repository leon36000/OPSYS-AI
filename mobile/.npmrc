# react-dom est un pair optionnel de expo/expo-router/@expo/metro-runtime (support web, non
# utilisé ici — app mobile iOS/Android seulement, cf. docs/architecture/MOBILE.md). npm résout
# parfois ce graphe de pairs optionnels en erreur ERESOLVE dure plutôt qu'en avertissement selon
# l'ordre d'installation ; legacy-peer-deps évite ce faux blocage sans changer les versions
# réellement installées (vérifiées une à une, voir docs/research/INGREDIENTS.md).
legacy-peer-deps=true
