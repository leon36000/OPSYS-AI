{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsys-ai/proof/schemas/gate.schema.json",
  "schema_version": "1.0",
  "title": "OPSYS-AI Proof Gate Run",
  "type": "object",
  "required": ["schema_version", "phase", "run_id", "commit", "tree", "status", "checks"],
  "properties": {
    "schema_version": {"type": "string"},
    "phase": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["MEASURED_PASS", "MEASURED_FAIL"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "argv", "expected_returncode", "actual_returncode"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_returncode": {"type": "integer"},
          "actual_returncode": {"type": "integer"}
        }
      }
    }
  }
}
