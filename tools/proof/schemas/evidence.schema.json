{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsys-ai/proof/schemas/evidence.schema.json",
  "schema_version": "1.0",
  "title": "OPSYS-AI Proof Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "implementer_id", "commit", "tree",
    "inputs_manifest", "outputs_manifest", "commands"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "task_id": {"type": "string", "minLength": 1},
    "implementer_id": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/manifest_entry"}
    },
    "outputs_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/manifest_entry"}
    },
    "commands": {
      "type": "array",
      "items": {"$ref": "#/$defs/command"}
    }
  },
  "$defs": {
    "manifest_entry": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "command": {
      "type": "object",
      "required": ["argv", "expected_returncode", "actual_returncode", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_returncode": {"type": "integer"},
        "actual_returncode": {"type": "integer"},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
