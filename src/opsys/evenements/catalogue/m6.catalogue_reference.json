{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsys.evenement/v1/m6.catalogue_reference",
  "title": "Référence privée de version de catalogue M6",
  "description": "Rang, version et empreinte source seulement. Aucun texte, prix, auteur ni identifiant libre. M10 SENSITIVE hors affaire.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fait_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_genre": {
      "type": "string",
      "enum": [
        "m6_materiaux"
      ]
    },
    "source_rang": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "horodatage": {
      "type": "string",
      "format": "date-time",
      "maxLength": 50
    }
  },
  "required": [
    "fait_id",
    "source_genre",
    "source_rang",
    "source_revision",
    "source_sha256",
    "horodatage"
  ]
}
