# NON-ACTIVE EXAMPLE — do not copy unchanged into .github/workflows/
# Task C02-005 must create the real workflow and pin every GitHub Action by full commit SHA.
# The validator intentionally rejects active workflow files shipped by this unified pack v2.3.0.
name: OPSYS Core task governance (example only)
on:
  pull_request:
    types: [opened, edited, synchronize, reopened, ready_for_review]
  issues:
    types: [closed, reopened, labeled, unlabeled]
permissions:
  contents: read
  issues: read
  pull-requests: read
jobs:
  contract:
    runs-on: ubuntu-latest
    steps:
      - name: Intentional blocker until C02-005 creates a SHA-pinned workflow
        run: |
          echo "This is a non-active design example. C02-005 must generate the real workflow with immutable action SHAs."
          exit 1
