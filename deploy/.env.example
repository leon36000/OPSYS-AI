# Variables privées de l'installation Docker OPSYS.
# deploy/install.sh génère tous les secrets vides avant de lancer Compose.
# Ne jamais mettre de valeur réelle dans ce fichier ni le partager avec un secret.

OPSYS_MCP_JETON=
# Jeton séparé, réservé au moteur de contexte interne; différent du bearer MCP des outils.
OPSYS_CONTEXT_MCP_JETON=
OPENCLAW_GATEWAY_TOKEN=

# Passerelle de modèles : LiteLLM est le profil PAR DÉFAUT du déploiement (deploy/install.sh y met `litellm` si la valeur est
# vide). `natif` reste possible (fournisseurs directs, sans passerelle). Une clé de fournisseur (OpenRouter, direct) se saisit
# UNE fois dans le coffre OPSYS, pas ici (docs/architecture/PASSERELLE-DE-MODELES.md).
OPSYS_MODE_FOURNISSEUR=
# 1 = LiteLLM EXISTANT chez le client : aucun conteneur LiteLLM n'est démarré ; OPSYS_PASSERELLE_URL est alors obligatoire et
# la clé du client va dans le coffre. 0 = LiteLLM fourni par le profil `litellm` (URL http://litellm:4000 par défaut).
OPSYS_PASSERELLE_EXTERNE=
OPSYS_PASSERELLE_URL=
OPSYS_DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=

# Embeddings locaux optionnels : le profil R41 exige des assets BGE-M3 déjà vérifiés.
# Ne pas mettre de vrai jeton dans Git; générer une valeur privée d'au moins 24 caractères.
OPSYS_EMBEDDINGS_URL=
OPSYS_EMBEDDINGS_MODELE=
OPSYS_EMBEDDINGS_CLE=
OPSYS_EMBEDDINGS_LOCAL=0
OPSYS_EMBEDDINGS_TAILLE_LOT=32
# Chemin hôte, seulement pour le profil opt-in R41 (pas de téléchargement implicite).
OPSYS_BGE_M3_ASSETS=

# Ces réglages sont générés en mode LiteLLM intégré (le défaut ; sauf OPSYS_PASSERELLE_EXTERNE=1).
LITELLM_MASTER_KEY=
POSTGRES_OPSYS_PASSWORD=
POSTGRES_LITELLM_PASSWORD=
OPSYS_CONSOLE_SECRET=
OPSYS_CLE_M1=
OPSYS_CLE_M2=
OPSYS_CLE_M3=
OPSYS_CLE_M4=
OPSYS_CLE_M5=
OPSYS_CLE_M6=
OPSYS_CLE_M7=
OPSYS_CLE_M8=
OPSYS_CLE_M9=
OPSYS_CLE_M10=

# Paramètres opérateur facultatifs.
OPSYS_DOMAINE=
ACME_EMAIL=
