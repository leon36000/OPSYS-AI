     du module, jamais un fragment `core/tests` orphelin en plus."""
     texte = '      - run: python3 -m pytest "Modules M/M5-financecore/tests" -q\n'
     assert _chemins_de_test_cites(texte) == {"Modules M/M5-financecore/tests"}
