+        f"      - uses: actions/checkout@{_SHA_VALIDE.upper()}\n"
+        f"      - uses: 'actions/checkout @{_SHA_VALIDE}'\n"
+        f"      - uses: 'actions/checkout@ {_SHA_VALIDE}'\n"
+        f"      - uses: checkout@{_SHA_VALIDE}\n"
+    )
+    assert [chemin for chemin, _ref in _refs_uses(data)] == [
+        "jobs.a.steps[0].uses",
+        "jobs.a.steps[1].uses",
+        "jobs.a.steps[2].uses",
+        "jobs.a.steps[3].uses",
+    ]
+    assert len(_actions_non_epinglees(data)) == 4
